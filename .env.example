# Copy to .env and fill in only if Google Sheets sync is wanted.
GSHEETS_AUTO_SYNC=False
GSHEETS_SPREADSHEET_ID=
GSHEETS_SERVICE_ACCOUNT_FILE=
# One spreadsheet per dataset (publish_sheets.py): the Shared Drive or folder ID (or its link)
# where the service account is a Content manager. When set, GSHEETS_AUTO_SYNC should be False.
GSHEETS_FOLDER_ID=
# listings_pipeline.py shares the spreadsheet with these addresses (comma separated).
GSHEETS_SHARE_WITH=
# reader, commenter or writer
GSHEETS_SHARE_ROLE=reader
# Optional database location. Relative paths resolve beside scrapy.cfg.
# AUSTENDER_DB_DIR=databases
# Optional alerting: a healthchecks.io (or similar) ping URL. The runner pings
# <url>/start, <url> on success and <url>/fail on failure; the service emails you
# when a run fails or no run arrives within the expected schedule.
HEALTHCHECK_URL=

# ── Outreach emails (outreach.py) ────────────────────────────────────────────
# Who the emails come from. Spam Act 2003: identify the sender and offer an opt-out.
OUTREACH_FROM_NAME=
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_TO=
OUTREACH_COMPANY=Illoura Services
OUTREACH_ABN=
OUTREACH_PHONE=
OUTREACH_ADDRESS=
# Comma-separated words that make a tender "about people" (default: built-in staffing list).
OUTREACH_KEYWORDS=
OUTREACH_MAX_PER_RUN=20
# Also overrides the agent's pause (30s during warm-up, 10s after); leave unset for that.
OUTREACH_DELAY_SECONDS=30
OUTREACH_COOLDOWN_DAYS=14
# Your mailbox's SMTP server. Google Workspace: smtp.gmail.com 587 + an app password.
# Microsoft 365: smtp.office365.com 587 (SMTP AUTH must be enabled for the mailbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Outreach agent (outreach_agent.py) ───────────────────────────────────────
# test: every email goes to OUTREACH_TEST_RECIPIENT. live: to the real contacts.
OUTREACH_MODE=test
OUTREACH_TEST_RECIPIENT=
# Gmail address the agent sends from, and its 16-letter App Password.
OUTREACH_FROM_EMAIL=
gaccount_pwd=
# Where replies, alerts and the daily summary are forwarded.
OUTREACH_FORWARD_TO=
# Full daily cap after the 14-day warm-up (5/day).
OUTREACH_DAILY_CAP=20
# Public holidays that pause sending: national + this state.
OUTREACH_HOLIDAY_STATE=ACT
# AI writer (Groq).
groq_api_key=
OUTREACH_LLM_MODEL=openai/gpt-oss-120b
# Optional: OUTREACH_SEND_FROM_HOUR=9, OUTREACH_SEND_TO_HOUR=16, OUTREACH_MIN_DAYS_TO_CLOSE=2,
# OUTREACH_MAX_BOUNCES=3, OUTREACH_LLM_REASONING=low
