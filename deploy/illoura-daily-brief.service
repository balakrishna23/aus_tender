[Unit]
Description=Illoura daily brief: collect and publish, compose, send once at 08:15 Sydney
After=network-online.target
Wants=network-online.target
OnFailure=illoura-cloud-health.service
[Service]
Type=oneshot
WorkingDirectory=/opt/aus_tender
ExecStart=/opt/aus_tender/.venv/bin/python /opt/illoura-ops/illoura_daily_brief.py run
TimeoutStartSec=6h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=5G
CPUQuota=150%
