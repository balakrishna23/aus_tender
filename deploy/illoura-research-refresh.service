[Unit]
Description=Illoura publisher research refresh (no email)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/illoura-market/research-refresh.env
ExecStart=/opt/aus_tender/.venv/bin/python /opt/illoura-ops/illoura_research_refresh.py
UMask=0077
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2700
KillMode=control-group
SendSIGKILL=yes
# NoNewPrivileges stops the unprivileged application (runuser -> ubuntu) from regaining root through sudo.
# Do not add ProtectKernelTunables/ProtectKernelModules/RestrictAddressFamilies: with NoNewPrivileges they drop
# CAP_SETUID on this server (systemd 255), so runuser fails with "cannot set user id" and the refresh never starts.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true

