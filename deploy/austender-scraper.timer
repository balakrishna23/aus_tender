[Unit]
Description=Run the procurement scrapers every 6 hours (Sydney time)

[Timer]
# 06:15, 12:15, 18:15 and 00:15 Sydney time. Most notices are published during
# business hours, so these runs pick them up mid-morning, mid-afternoon and overnight.
OnCalendar=*-*-* 00,06,12,18:15:00 Australia/Sydney
# Run straight away after the server was off at a scheduled time.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
