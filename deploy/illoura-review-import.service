[Unit]
Description=Apply scoped human research decisions (no network or email)
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
ExecStart=/opt/aus_tender/.venv/bin/python /opt/illoura-ops/illoura_review_import.py
UMask=0027
TimeoutStartSec=130
Restart=on-failure
RestartSec=300
KillMode=control-group
SendSIGKILL=yes
# NoNewPrivileges stops the unprivileged importer (runuser -> ubuntu) from regaining root through sudo.
# Do not add ProtectKernelTunables/ProtectKernelModules/RestrictAddressFamilies: with NoNewPrivileges they drop
# CAP_SETUID on this server (systemd 255), so runuser fails with "cannot set user id" and the import never runs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
